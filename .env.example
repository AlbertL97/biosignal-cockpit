# ==========================================================================
# Health_analysis — environment template
# Copy this file to ".env" and fill in real values.
# The real .env file is git-ignored and must NEVER be committed.
# ==========================================================================

# --- Yazio account (email/password login only; social logins are unsupported)
YAZIO_EMAIL=you@example.com
YAZIO_PASSWORD=your-yazio-password

# --- Optional: override default export output location
YAZIO_OUTPUT_DIR=data/yazio
